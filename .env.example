# 通用 OpenAI 兼容视觉供应商配置
API_KEY=your_key_here

# 接口地址（默认 ModelScope，可替换为任意 OpenAI 兼容端点）
# BASE_URL=https://api-inference.modelscope.cn/v1

# 视觉模型（默认 Qwen/Qwen3-VL-8B-Instruct）
# VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# 可选调参（默认 0.7 / 32768）
# TEMPERATURE=0.7
# MAX_TOKENS=32768

# 可选: 启用工具白名单（逗号分隔；留空=全部。仅影响 MCP 模式，减少 agent 上下文占用）
# TOOLS=analyze_image,extract_text
