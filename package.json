{
  "name": "@me9rez/llm-vision-mcp",
  "version": "0.0.3",
  "description": "给文本模型装上眼睛 — MCP Server + OpenAI 兼容视觉模型（默认通义千问VL via ModelScope），图片文件 → 视觉模型 → 文字描述 / Give text-only LLMs vision via any OpenAI-compatible vision model",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "src/",
    "README.md"
  ],
  "bin": {
    "llm-vision-mcp": "index.js"
  },
  "scripts": {
    "start": "node index.js mcp",
    "smoke": "vitest run tests/smoke.test.mjs",
    "test": "vitest run",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "preview:hero": "node scripts/render-svg.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "vision",
    "qwen-vl",
    "modelscope",
    "llm",
    "claude-code",
    "deepseek",
    "opencode"
  ],
  "author": "me9rez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/me9rez/llm-vision-mcp.git"
  },
  "homepage": "https://www.npmjs.com/package/@me9rez/llm-vision-mcp",
  "bugs": {
    "url": "https://github.com/me9rez/llm-vision-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "openai": "^7.3.0",
    "type-flag": "^4.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "release-it": "^21.0.1",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
