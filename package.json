{
  "name": "@me9rez/llm-vision-mcp",
  "version": "1.0.0",
  "description": "给文本模型装上眼睛 — MCP Server + OpenAI 兼容视觉模型（默认通义千问VL via ModelScope），图片文件 → 视觉模型 → 文字描述 / Give text-only LLMs vision via any OpenAI-compatible vision model",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "README.md",
    ".env.example",
    "examples/"
  ],
  "bin": {
    "llm-vision-mcp": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "smoke": "vitest run tests/smoke.test.mjs",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "vision",
    "qwen-vl",
    "modelscope",
    "llm",
    "claude-code",
    "deepseek",
    "opencode"
  ],
  "author": "llm-vision-mcp",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "openai": "^7.3.0",
    "type-flag": "^4.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
