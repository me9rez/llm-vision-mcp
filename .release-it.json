{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "push": true
  },
  "github": {
    "release": true,
    "autoGenerate": true,
    "proxy": "http://127.0.0.1:7890"
  },
  "npm": {
    "publish": true
  },
  "hooks": {
    "before:init": ["npm test"]
  }
}